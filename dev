set -Eeuo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
VENV="$ROOT/.venv"
PYTHON="$VENV/bin/python"
DEVLEGATE="$VENV/bin/devlegate"

usage() {
  cat <<'EOF'
Usage: ./dev <command> [args...]

Local development helper for Devlegate.

Commands:
  setup             Create .venv and install the project and development tools
  test [args...]    Run pytest
  test-parallel     Run pytest with four worksteal workers
  lint [args...]    Run Ruff check
  check             Run tests and lint
  coverage          Run pytest with statement/branch coverage
  run [args...]     Run the installed devlegate CLI
  package COMMAND   Build validated source-tree distribution artifacts
  clean             Remove named caches and build artifacts
  purge             Clean, then remove .venv and named development artifacts

Options:
  -h, --help        Show this help message

Run ./dev setup before test, lint, check, run, or package.
EOF
}

require_venv() {
  if [[ ! -x "$PYTHON" ]]; then
    printf 'dev: .venv is missing; run ./dev setup first\n' >&2
    exit 1
  fi
}

require_devlegate() {
  require_venv
  if [[ ! -x "$DEVLEGATE" ]]; then
    printf 'dev: installed devlegate CLI is missing; run ./dev setup first\n' >&2
    exit 1
  fi
}

setup() {
  if [[ ! -x "$PYTHON" ]]; then
    "${PYTHON_BIN:-python3}" -m venv "$VENV"
  fi
  "$PYTHON" -m pip install -e "$ROOT[dev]"
}

test() {
  require_venv
  "$PYTHON" -m pytest "$@"
}

test_parallel() {
  require_venv
  "$PYTHON" -m pytest -n 4 --dist=worksteal "$@"
}

lint() {
  require_venv
  "$PYTHON" -m ruff check src tests tools "$@"
}

check() {
  local status=0
  test || status=$?
  lint || { local lint_status=$?; ((status == 0)) && status=$lint_status; }
  return "$status"
}

remove_path() {
  if [[ -e "$1" ]]; then
    rm -rf -- "$1"
  fi
}

clean_coverage() {
  remove_path "$ROOT/.coverage"
  for coverage_file in "$ROOT"/.coverage.*; do
    if [[ -e "$coverage_file" ]]; then
      rm -f -- "$coverage_file"
    fi
  done
  remove_path "$ROOT/coverage.json"
  remove_path "$ROOT/htmlcov"
}

clean() {
  remove_path "$ROOT/.pytest_cache"
  remove_path "$ROOT/.ruff_cache"
  remove_path "$ROOT/build"
  remove_path "$ROOT/dist"
  remove_path "$ROOT/src/devlegate/__pycache__"
  remove_path "$ROOT/tests/__pycache__"
  remove_path "$ROOT/devlegate.egg-info"
  remove_path "$ROOT/src/devlegate.egg-info"
  clean_coverage
}

purge() {
  clean
  remove_path "$ROOT/.venv"
  remove_path "$ROOT/.tox"
  remove_path "$ROOT/.nox"
  remove_path "$ROOT/.mypy_cache"
}

if (($# == 0)) || [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

command=$1
shift
case "$command" in
  setup) setup "$@" ;;
  test) test "$@" ;;
  test-parallel) test_parallel "$@" ;;
  lint) lint "$@" ;;
  check) check "$@" ;;
  coverage)
    require_venv
    clean_coverage
    "$PYTHON" -m coverage run -m pytest "$@"
    "$PYTHON" -m coverage combine
    "$PYTHON" -m coverage report -m
    "$PYTHON" -m coverage json -o "$ROOT/coverage.json"
    ;;
run)
    require_devlegate
    exec "$DEVLEGATE" "$@"
    ;;
  package)
    require_venv
    exec "$PYTHON" "$ROOT/tools/build_distribution.py" "$@"
    ;;
  clean) clean "$@" ;;
  purge) purge "$@" ;;
  *)
    printf 'dev: unknown command: %s\n\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
