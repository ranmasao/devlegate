# Template for a project-local $PWD/.env. Devlegate runs from the root of an already configured project checkout.
REMOTE_NAME=origin
# REMOTE_BRANCH=main

# Current directory-based ticket states.
TODO_PATH=kanban/todo
REVIEW_PATH=kanban/review
POLL_INTERVAL=300

# Fresh OpenCode process per run.
AGENT_PROMPT_FILE=/path/to/agent-prompt.txt
OPENCODE_BIN=opencode
OPENCODE_MODEL=provider/model
# OPENCODE_AGENT=build

# Optional lock/state location outside the project repository.
# STATE_DIR=/path/to/devlegate-state
