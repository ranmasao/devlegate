# Canonical remote URL for the current local checkout.
REPO_URL=https://github.com/owner/repository.git

# Remote synchronization and local file polling.
REMOTE_NAME=origin
REMOTE_BRANCH=main
WATCH_PATH=src
POLL_INTERVAL=300

# Fresh opencode process per run. The prompt file is never persisted in the repo.
AGENT_PROMPT_FILE=/path/to/agent-prompt.txt
OPENCODE_BIN=opencode
# OPENCODE_MODEL=provider/model
# OPENCODE_AGENT=build

# auto tries AUTHENTICATED_REPO_URL, GITHUB_TOKEN, then gh auth.
# AUTH_MODE=auto
# GITHUB_TOKEN=github_pat_...
# AUTHENTICATED_REPO_URL=https://x-access-token:TOKEN@github.com/owner/repository.git
# With AUTH_MODE=url, REPO_URL itself may be the credential-bearing URL.

COMMIT_PREFIX=devlegate
PUSH_BRANCH=main
# STATE_DIR=/path/to/devlegate-state
