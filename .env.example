# Template for a project-local $PWD/.env. Devlegate runs from the root of an already configured project checkout.
REMOTE_NAME=origin
# REMOTE_BRANCH=main
CONTROL_BRANCH=devlegate/control

# Current directory-based ticket states. All five paths are explicit.
BACKLOG_PATH=kanban/backlog
TODO_PATH=kanban/todo
REVIEW_PATH=kanban/review
ACCEPTED_PATH=kanban/accepted
DONE_PATH=kanban/done
POLL_INTERVAL=300

# Fresh OpenCode process per run when worker dispatch is enabled.
OPENCODE_BIN=opencode
# Required for worker dispatch; select a model explicitly.
OPENCODE_MODEL=
# OPENCODE_AGENT=build

# Persistent state and locks. The default is $XDG_STATE_HOME/devlegate,
# or ~/.local/state/devlegate when XDG_STATE_HOME is not set.
# STATE_DIR=~/.local/state/devlegate

# Execution worktrees are managed automatically outside the operator checkout:
# $STATE_DIR/worktrees/<repository-key>/work/<ticket-id>
# Branches are local durable history: devlegate/work/<ticket-id>
