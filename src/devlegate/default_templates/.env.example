# Project-local Devlegate configuration. Set OPENCODE_MODEL before running devlegate run.
REMOTE_NAME=origin
# REMOTE_BRANCH=main
CONTROL_BRANCH=devlegate/control
BACKLOG_PATH=kanban/backlog
TODO_PATH=kanban/todo
REVIEW_PATH=kanban/review
ACCEPTED_PATH=kanban/accepted
DONE_PATH=kanban/done
POLL_INTERVAL=300
OPENCODE_BIN=opencode
# Required for worker dispatch; leave empty until a model is selected.
OPENCODE_MODEL=
# OPENCODE_AGENT=build
# STATE_DIR=~/.local/state/devlegate
